<Window x:Class="FastReport.Designer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ribbon="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon"
        xmlns:local="clr-namespace:FastReport.Designer" 
        Title="FastReport Designer" 
        Height="720" Width="1280"
        Icon="/FastReportIcon.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowState="Maximized">
    
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- Toolbox -->
            <ColumnDefinition Width="*"/>
            <!-- Canvas -->
            <ColumnDefinition Width="300"/>
            <!-- Properties -->
        </Grid.ColumnDefinitions>

        <!-- منوی Ribbon -->
        <ribbon:Ribbon Grid.Row="0" Grid.ColumnSpan="3" Background="#F3F3F3" BorderBrush="#D4D4D4">
            <ribbon:Ribbon.ApplicationMenu>
                <ribbon:RibbonApplicationMenu>
                    <ribbon:RibbonApplicationMenuItem Header="Open Report..." Click="MenuItem_Open_Click"/>
                    <ribbon:RibbonApplicationMenuItem Header="Save Report..." Click="MenuItem_Save_Click"/>
                    <ribbon:RibbonApplicationMenuItem Header="Export to PDF..." Click="MenuItem_ExportPdf_Click"/>
                </ribbon:RibbonApplicationMenu>
            </ribbon:Ribbon.ApplicationMenu>

            <ribbon:RibbonTab Header="Home">
                <ribbon:RibbonGroup Header="File Options">
                    <ribbon:RibbonButton Label="Open" Click="MenuItem_Open_Click" />
                    <ribbon:RibbonButton Label="Save" Click="MenuItem_Save_Click" />
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="Export">
                    <ribbon:RibbonButton Label="PDF" Click="MenuItem_ExportPdf_Click" />
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

            <ribbon:RibbonTab Header="Insert">
                <ribbon:RibbonGroup Header="Elements">
                    <ribbon:RibbonButton Label="Text Box" />
                    <ribbon:RibbonButton Label="Image" />
                    <ribbon:RibbonButton Label="Chart" Click="RibbonButton_AddChart_Click" Background="#E3F2FD"/>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>
        </ribbon:Ribbon>

        <!-- پنل سمت چپ: Toolbox -->
        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <StackPanel Margin="10">
                <TextBlock Text="Toolbox" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>

                <Button Name="btnDragText" Content="Text Box" Height="35" Margin="0,0,0,10" Background="#E3F2FD" Cursor="Hand"
                        PreviewMouseLeftButtonDown="btnDragText_PreviewMouseLeftButtonDown"/>

                <Button Name="btnDragImage" Content="Image" Height="35" Margin="0,0,0,10" Background="#E3F2FD" Cursor="Hand"/>

                <Button Name="btnDragChart" Content="Chart" Height="35" Margin="0,0,0,10" Background="#E3F2FD" Cursor="Hand"
                        PreviewMouseLeftButtonDown="btnDragChart_PreviewMouseLeftButtonDown"/>
            </StackPanel>
        </Border>

        <!-- پنل وسط: بوم طراحی به همراه خط‌کش‌ها -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#E0E0E0">
            <!-- این گرید جدید، صفحه و خط‌کش‌ها را یکپارچه می‌کند -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <!-- ارتفاع خط‌کش افقی -->
                    <RowDefinition Height="1123"/>
                    <!-- ارتفاع صفحه A4 -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <!-- عرض خط‌کش عمودی -->
                    <ColumnDefinition Width="794"/>
                    <!-- عرض صفحه A4 -->
                </Grid.ColumnDefinitions>

                <!-- مربع تقاطع دو خط‌کش (گوشه بالا سمت چپ) -->
                <Border Grid.Row="0" Grid.Column="0" Background="WhiteSmoke" BorderBrush="DarkGray" BorderThickness="0,0,1,1"/>

                <!-- خط‌کش افقی -->
                <local:Ruler Grid.Row="0" Grid.Column="1" Orientation="Horizontal"/>

                <!-- خط‌کش عمودی -->
                <local:Ruler Grid.Row="1" Grid.Column="0" Orientation="Vertical"/>

                <!-- صفحه A4 در مرکز -->
                <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="DarkGray" BorderThickness="0,0,1,1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="2"/>
                    </Border.Effect>

                    <Canvas Name="DesignCanvas" 
        AllowDrop="True" Drop="DesignCanvas_Drop" MouseLeftButtonDown="DesignCanvas_MouseLeftButtonDown">
                        <!-- رسم خطوط شطرنجی پس‌زمینه با فاصله 10 پیکسل -->
                        <Canvas.Background>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing>
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,10,10"/>
                                        </GeometryDrawing.Geometry>
                                        <GeometryDrawing.Pen>
                                            <!-- رنگ خطوط شطرنجی (خاکستری بسیار روشن) -->
                                            <Pen Brush="#EBEBEB" Thickness="1"/>
                                        </GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Canvas.Background>
                    </Canvas>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- پنل سمت راست: تنظیمات -->
        <Border Grid.Row="1" Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0">
            <StackPanel Margin="15">
                <TextBlock Text="Properties" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>

                <TextBlock Name="txtNoSelection" Text="Select an element to edit" Foreground="Gray"/>

                <!-- تنظیمات متنی -->
                <StackPanel Name="pnlTextProperties" Visibility="Collapsed">
                    <TextBlock Text="Text Content:" FontSize="12" Foreground="DarkSlateGray" Margin="0,0,0,5"/>
                    <TextBox Name="txtBoxContent" Height="30" Padding="5" Margin="0,0,0,10" TextChanged="txtBoxContent_TextChanged"/>

                    <TextBlock Text="Font Size:" FontSize="12" Foreground="DarkSlateGray" Margin="0,0,0,5"/>
                    <TextBox Name="txtBoxFontSize" Height="30" Padding="5" Margin="0,0,0,10" TextChanged="txtBoxFontSize_TextChanged"/>

                    <TextBlock Text="Hex Color (#RRGGBB):" FontSize="12" Foreground="DarkSlateGray" Margin="0,0,0,5"/>
                    <TextBox Name="txtBoxColor" Height="30" Padding="5" Margin="0,0,0,15" TextChanged="txtBoxColor_TextChanged"/>

                    <TextBlock Text="Data Binding (JSON Path):" FontSize="12" Foreground="DarkSlateGray" Margin="0,0,0,5"/>
                    <TextBox Name="txtBoxDataBinding" Height="30" Padding="5" Margin="0,0,0,10"/>
                </StackPanel>

                <!-- تنظیمات نمودار -->
                <StackPanel Name="pnlChartProperties" Visibility="Collapsed">
                    <TextBlock Text="Chart Type:" FontSize="12" Foreground="DarkSlateGray" Margin="0,0,0,5"/>
                    <ComboBox Name="cmbChartType" Height="30" Margin="0,0,0,10" SelectionChanged="cmbChartType_SelectionChanged">
                        <ComboBoxItem Content="Bar"/>
                        <ComboBoxItem Content="Pie"/>
                    </ComboBox>

                    <TextBlock Text="Array Path (e.g. SalesData):" FontSize="12" Foreground="DarkSlateGray" Margin="0,0,0,5"/>
                    <TextBox Name="txtChartDataPath" Height="30" Padding="5" Margin="0,0,0,10" TextChanged="txtChartDataPath_TextChanged"/>

                    <TextBlock Text="X-Axis Field (e.g. Month):" FontSize="12" Foreground="DarkSlateGray" Margin="0,0,0,5"/>
                    <TextBox Name="txtChartXAxis" Height="30" Padding="5" Margin="0,0,0,10" TextChanged="txtChartXAxis_TextChanged"/>

                    <TextBlock Text="Y-Axis Field (e.g. Amount):" FontSize="12" Foreground="DarkSlateGray" Margin="0,0,0,5"/>
                    <TextBox Name="txtChartYAxis" Height="30" Padding="5" Margin="0,0,0,10" TextChanged="txtChartYAxis_TextChanged"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>